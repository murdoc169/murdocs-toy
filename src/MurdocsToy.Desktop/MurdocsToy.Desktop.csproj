<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MurdocsToy</AssemblyName>
    <Version>0.6.2</Version>
    <Product>Murdoc's Toy</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\web\public\*.*" LogicalName="web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\web\public\flags\*.*" LogicalName="web/flags/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <ProjectReference Include="..\MurdocsToy.Core\MurdocsToy.Core.csproj" />
  </ItemGroup>
</Project>
